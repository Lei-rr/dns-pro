{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "exclude": ["exports", "types"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,ts}"],
      "project": ["server/src/**/*.ts", "scripts/**/*.{mjs,ts}"]
    },
    "web": {
      "entry": ["src/app/styles/index.css"],
      "project": ["src/**/*.{ts,vue}"]
    }
  }
}

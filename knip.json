{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,ts}", "server/**/*.{test,spec}.ts"],
      "project": ["server/**/*.ts", "scripts/**/*.{mjs,ts}"]
    },
    "web": {
      "entry": ["src/app/styles/index.css", "src/**/*.{test,spec}.ts"],
      "project": ["src/**/*.{ts,vue,css}"]
    }
  },
  "ignoreIssues": {
    "server/modules/cloudflare/cloudflare-response.schema.ts": ["types"],
    "server/modules/dnspod/dns-pod-response.schema.ts": ["types"],
    "server/modules/edge-one/edge-one-response.schema.ts": ["types"]
  }
}

{
  "name": "dns-pro",
  "version": "1.0.0",
  "description": "DNSPod / Cloudflare / Cloudflare for SaaS / Cloudflare Tunnel / 腾讯云 EdgeOne 一体的 DNS 与隧道管理面板（Node.js 版）",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "tsx watch src/server.ts --port 3022",
    "dev:server:debug": "tsx watch src/server.ts --port 3022 --log-level info | pino-pretty",
    "dev:web": "npm --workspace dns-pro-web run dev",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js --port 2022",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup src/server.ts --format esm --out-dir dist --target node20 --clean",
    "build:web": "npm --workspace dns-pro-web run build",
    "lint": "eslint src web/src scripts",
    "lint:fix": "eslint src web/src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"web/src/**/*.{ts,js,vue}\" \"scripts/**/*.{mjs,ts}\" \"*.{json,mjs}\" \"web/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/src/**/*.{ts,js,vue}\" \"scripts/**/*.{mjs,ts}\" \"*.{json,mjs}\" \"web/*.json\"",
    "arch": "node scripts/check-architecture.mjs",
    "arch:final": "ARCH_FINAL=1 node scripts/check-architecture.mjs",
    "deadcode": "knip --treat-config-hints-as-errors",
    "deps:check": "node scripts/check-dependencies.mjs && npm audit --omit=dev --audit-level=high",
    "routes:manifest": "tsx scripts/generate-route-manifest.ts",
    "routes:check": "tsx scripts/generate-route-manifest.ts --check",
    "probe:api": "tsx scripts/isolated-api-probe.ts",
    "probe:job": "tsx scripts/isolated-job-progress-probe.ts",
    "probe:platform": "tsx scripts/isolated-platform-concurrency-probe.ts",
    "probe:workflow": "tsx scripts/isolated-workflow-recovery-probe.ts && tsx scripts/isolated-tunnel-route-probe.ts && tsx scripts/isolated-request-param-probe.ts && tsx scripts/isolated-edgeone-payload-probe.ts && tsx scripts/isolated-backend-safe-probe.ts && tsx scripts/isolated-backend-careful-probe.ts && tsx scripts/isolated-default-config-probe.ts",
    "probe:functional": "tsx scripts/isolated-functional-surface-probe.ts && tsx scripts/isolated-frontend-audit-probe.ts",
    "probe:static": "tsx scripts/isolated-static-probe.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --workspace dns-pro-web run typecheck",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:web && npm run arch:final && npm run deadcode && npm run deps:check && npm run routes:check && npm run probe:api && npm run probe:job && npm run probe:platform && npm run probe:workflow && npm run probe:functional && npm run build && npm run probe:static"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "typebox": "^1.3.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "@vue/compiler-sfc": "^3.5.26",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "knip": "^5.88.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "keywords": [
    "dns",
    "cloudflare",
    "dnspod",
    "edgeone",
    "cloudflared",
    "dns-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lei-rr/dns-pro.git"
  },
  "bugs": {
    "url": "https://github.com/lei-rr/dns-pro/issues"
  },
  "homepage": "https://github.com/lei-rr/dns-pro#readme"
}

{
  "name": "dns-pro",
  "version": "1.1.0",
  "description": "DNSPod / Cloudflare / Cloudflare for SaaS / Cloudflare Tunnel / 腾讯云 EdgeOne 一体的 DNS 与隧道管理面板（Node.js 版）",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "nanoid": ">=3.3.17",
    "brace-expansion": ">=5.0.12",
    "ip-address": ">=10.7.3",
    "fast-uri": ">=4.2.1",
    "image-size": ">=1.2.1",
    "less": ">=4.8.1"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "tsx watch server/main.ts --port 3022",
    "dev:server:debug": "tsx watch server/main.ts --port 3022 --log-level info | pino-pretty",
    "dev:web": "npm --workspace dns-pro-web run dev",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js --port 2022",
    "build": "npm run build:server && npm run build:web",
    "build:server": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && esbuild server/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server.js && node --check dist/server.js",
    "build:web": "npm --workspace dns-pro-web run build",
    "lint": "eslint \"*.ts\" server web/src scripts",
    "lint:fix": "eslint \"*.ts\" server web/src scripts --fix",
    "format": "prettier --write \"server/**/*.ts\" \"web/src/**/*.{ts,js,vue}\" \"scripts/**/*.{mjs,ts}\" \"*.{ts,json,mjs}\" \"web/*.json\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"web/src/**/*.{ts,js,vue}\" \"scripts/**/*.{mjs,ts}\" \"*.{ts,json,mjs}\" \"web/*.json\"",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "arch": "node scripts/check-architecture.mjs --final",
    "arch:final": "node scripts/check-architecture.mjs --final",
    "deadcode": "knip --treat-config-hints-as-errors",
    "deps:check": "node scripts/check-dependencies.mjs && npm audit --omit=dev --audit-level=high",
    "routes:manifest": "tsx scripts/generate-route-manifest.ts",
    "routes:check": "tsx scripts/generate-route-manifest.ts --check",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --workspace dns-pro-web run typecheck",
    "test": "vitest run",
    "verify": "npm run format:check && npm run version:check && npm run lint && npm run typecheck && npm run typecheck:web && npm run test && npm run arch:final && npm run deadcode && npm run deps:check && npm run routes:check && npm run build && npm run test:static",
    "test:static": "vitest run server/app/static-files.test.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "typebox": "^1.3.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "@vue/compiler-sfc": "^3.5.26",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.39.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  },
  "keywords": [
    "dns",
    "cloudflare",
    "dnspod",
    "edgeone",
    "cloudflared",
    "dns-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lei-rr/dns-pro.git"
  },
  "bugs": {
    "url": "https://github.com/lei-rr/dns-pro/issues"
  },
  "homepage": "https://github.com/lei-rr/dns-pro#readme"
}
